{
margin: 0;
padding: 0;
box-sizing: border-box;
}

body {
background-color: #f5f5f5;
font-family: Arial, sans-serif;
color: #333;
}

header {
background-color: #ffffff;
padding: 20px;
text-align: center;
}

h1 {
color: #333;
font-size: 32px;
}

main {
display: flex;
justify-content: center;
align-items: center;
padding: 40px 20px;
}

.flashcard {
background-color: #ffffff;
width: 400px;
min-height: 250px;
padding: 30px;
border-radius: 15px;
box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
}

.flashcard h2 {
font-size: 24px;
margin-bottom: 20px;
color: #2c3e50;
}

.flashcard p {
font-size: 18px;
line-height: 1.5;
}